# Copy to .env (cp .env.example .env) and paste ONE of the keys below.
# Without any key the app runs in mock mode (bundled samples only).

# Which model reads invoices: auto | gemini | anthropic | mock
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else mock
LLM_PROVIDER=auto

# Google Gemini (free tier: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude (paid: https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium


# Matching rules and the approval policy are edited in the app (Rules & settings).
